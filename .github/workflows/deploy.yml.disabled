name: Deploy to Production

# DURABLE DISARM (2026-09-22, issue #28): this workflow must NEVER auto-trigger.
# The push/tags triggers were removed so a bare rename of this file back to
# deploy.yml cannot re-arm auto-deploy-on-push against the production
# environment's live secrets. Manual-only (workflow_dispatch), deliberately.
on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to deploy"
        required: true
        default: "production"
        type: choice
        options:
          - staging
          - production

jobs:
  deploy:
    name: Deploy
    runs-on: ubuntu-latest
    environment: ${{ github.event.inputs.environment || 'production' }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # Configure Docker Hub (or your registry)
      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      # Build and push Docker image
      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: ./server
          push: true
          tags: |
            ${{ secrets.DOCKER_USERNAME }}/framer-port-api:latest
            ${{ secrets.DOCKER_USERNAME }}/framer-port-api:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # Deploy to server via SSH (example using SSH)
      # Uncomment and configure for your deployment method
      #
      # - name: Deploy to server
      #   uses: appleboy/ssh-action@master
      #   with:
      #     host: ${{ secrets.SSH_HOST }}
      #     username: ${{ secrets.SSH_USERNAME }}
      #     key: ${{ secrets.SSH_PRIVATE_KEY }}
      #     script: |
      #       cd /opt/framer-port
      #       docker-compose pull
      #       docker-compose up -d
      #       docker system prune -f

      - name: Deployment Notification
        if: success()
        run: |
          echo "✅ Image build + push complete."
          echo "Version: ${{ github.sha }}"
          echo "Image: ${{ secrets.DOCKER_USERNAME }}/framer-port-api:${{ github.sha }}"
          echo "NOTE: server deploy step is NOT configured (SSH block below) — images are built and pushed, nothing was deployed to a host."

  health-check:
    name: Health Check
    runs-on: ubuntu-latest
    needs: deploy

    steps:
      - name: Wait for deployment
        run: sleep 30

      - name: Check API health
        run: |
          # REQUIRED-BEFORE-ENABLE (#28): this step must not fake-pass.
          # Replace this block with the real endpoint check, e.g.:
          #   curl -f "${{ secrets.API_HEALTH_URL }}" || exit 1
          # Until then it fails loudly so an unconfigured re-enable cannot report green.
          echo "::error::Health check NOT CONFIGURED — refusing to fake-pass (issue #28, REQUIRED-BEFORE-ENABLE)"
          exit 1

      - name: Rollback notification
        if: failure()
        run: |
          echo "⚠️ Health check failed - check deployment status"
