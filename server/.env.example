# Server
MONGO_URI=mongodb://localhost:27017/portfolio
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Auth
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Proxy
# Proxy hops to trust for X-Forwarded-* headers. INTEGER ONLY (a quoted "1" would
# compile as a subnet in Express's proxyaddr). Leave UNSET when serving directly
# (false default keeps the forged-XFF tripwire armed); set to the hop count when
# behind a proxy (nginx = 1, nginx behind Cloudflare = 2).
# TRUST_PROXY=1
